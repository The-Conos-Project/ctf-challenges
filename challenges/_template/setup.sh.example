#!/bin/bash
set -euo pipefail

# Example author setup.
# - Never install sudoers NOPASSWD:ALL for the student
# - Prefer compiled execute-only checker/ask (chmod 111, owner root)
# - Re-assert those modes after any chown -R of /home/user

USER_HOME=/home/user
CHALL="$USER_HOME/challenges"
mkdir -p "$CHALL/01-example"
echo "Read the README and solve the task." >"$CHALL/01-example/README"

chown -R user:user "$USER_HOME"
# find "$CHALL" -type f \( -name checker -o -name ask \) -exec chown root:root {} \; -exec chmod 111 {} \;

echo "setup complete"
